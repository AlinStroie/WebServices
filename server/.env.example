# Server
NODE_ENV=development
PORT=5000

# URLs
CLIENT_URL=http://localhost:5174
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# General JWT secret
JWT_SECRET=replace_with_long_random_secret_min_32_chars

# Admin Auth
ADMIN_JWT_SECRET=replace_with_long_random_admin_secret_min_32_chars
ADMIN_COOKIE_NAME=asquared_admin_token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# Company Email
COMPANY_EMAIL=contact@example.com

# SMTP / Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="A Squared Studio <contact@example.com>"

# Rate limits
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
CONTACT_RATE_LIMIT_MAX=5
ANALYTICS_RATE_LIMIT_MAX=120